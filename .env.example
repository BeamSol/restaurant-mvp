# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Local development: run `npx supabase start` and copy the values it prints
# (or run `npx supabase status -o env`).
# Production: Supabase dashboard → Project Settings → API.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SECRET: server only. Used to invite admins and for login rate limiting.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Public URL of the site (used for invite links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for POST /api/revalidate (clears the website cache after seeding or editing in Supabase Studio)
REVALIDATE_SECRET=change-me-to-a-long-random-string
